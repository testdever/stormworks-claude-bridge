        "label": "標的の座標を FCS に渡し続ける"
      },
      {
        "op": "wait",
        "seconds": 8,
        "label": "砲塔が向くのを待つ"
      },
      {
        "op": "repeat",
        "times": 10,
        "steps": [
          {
            "op": "target_renew",
