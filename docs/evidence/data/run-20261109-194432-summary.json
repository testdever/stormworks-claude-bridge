{
  "script": {
    "name": "FCS 下調べ：2 km 先の標的に当たったことを数えられるか",
    "note": "本人は test calc（陸に固定した砲）のところに立ち、撃ちたい海の方向を向いて待つ。10 秒後、その方向の 2 km 先に claude_target を置き、その座標を test calc のつなぎのマイコン（q2 の Lua）の出力 1 = X、2 = Z、3 = Y（高さ）、4 = 1 でで FCS の目標の入力に渡し続ける。本人は射撃許可を入れて撃つ。当たった知らせ、標的が動き続けているか、天気が変わったかを見る。手で操作するので、一時停止しても 10 分までは止めない",
    "watch": {
      "addon_timeout_s": 600
    },
    "steps": [
      {
        "op": "weather",
        "fog": 0,
        "rain": 0,
        "wind": 0,
        "label": "天気を穏やかにする（霧・雨・風を 0）"
      },
      {
        "op": "wait",
        "seconds": 10,
        "label": "撃ちたい方向を向いて待つ"
      },
      {
        "op": "target",
        "vehicle": "claude_target",
        "distance": 2000,
        "y": 2,
        "label": "向いている方向の 2 km 先に標的を置く"
      },
      {
        "op": "aim_target",
        "label": "標的の座標を FCS に渡し続ける（test calc の並び：ch1 = X、ch2 = Z、ch3 = Y）",
        "channels": [
          1,
          3,
          2,
          4
        ]
      },
      {
        "op": "wait",
        "seconds": 300,
        "label": "射撃許可を入れて撃つ"
      },
      {
        "op": "target_despawn",
        "label": "標的を片付ける（FCS の目標は無効にする）"
      }
    ]
  },
