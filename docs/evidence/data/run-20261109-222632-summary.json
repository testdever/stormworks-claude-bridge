        ],
        "label": "標的の座標を FCS に渡し続ける"
      },
      {
        "op": "wait",
        "seconds": 8,
        "label": "砲塔が向くのを待つ"
      },
      {
        "op": "repeat",
        "times": 10,
        "steps": [
          {
            "op": "target_renew",
            "label": "新しい標的に置き直す（回転・速さ・傷なし）"
          },
          {
            "op": "wait",
            "seconds": 1.0,
            "label": "置き直した標的が着水するのを待つ"
          },
          {
            "op": "fire",
            "shots": 1,
