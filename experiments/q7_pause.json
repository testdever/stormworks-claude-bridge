{
  "name": "Q7 物理を止める（一時停止）",
  "steps": [
    {
      "op": "spawn",
      "vehicle": "claude_test",
      "offset": [
        0,
        3,
        6
      ],
      "label": "機体を置く（プレイヤーから 6m 先、3m 上）"
    },
    {
      "op": "wait",
      "seconds": 3,
      "label": "落ち着くのを待つ"
    },
    {
      "op": "set",
      "outputs": {
        "1": 1
      },
      "label": "モーターを回す"
    },
    {
      "op": "wait",
      "seconds": 4,
      "label": "回している間"
    },
    {
      "op": "wait",
      "seconds": 1,
      "label": "ここでゲームを一時停止する（Esc）"
    },
    {
      "op": "wait",
      "seconds": 20,
      "label": "止まるはずの時間"
    },
    {
      "op": "set",
      "outputs": {
        "1": 0
      },
      "label": "モーターを止める"
    },
    {
      "op": "despawn",
      "label": "片付ける"
    }
  ],
  "watch": {
    "stop_if": [
      {
        "ch": 8,
        "lt": -12,
        "reason": "機体が落ち続けている（置いた場所に足場がない）"
      }
    ]
  }
}
